# All of these are optional. With none set, runners connect with their own Strava API keys.

# Shared Strava app: lets runners click "Connect with Strava" without creating their own API application.
# Create one at https://www.strava.com/settings/api and set its "Authorization Callback Domain" to this
# site's host name (for example runbabyrun.netlify.app, without https://).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Signs sign-in cookies and encrypts Strava tokens. If empty, one is generated and kept in storage.
# Setting it here is safer, because the key then lives apart from the data it protects. 32+ random characters.
SESSION_SECRET=

# Shown on the privacy page.
CONTACT_EMAIL=

# Storage backend: leave empty to choose automatically (Netlify Database if NETLIFY_DB_URL exists, else Netlify Blobs
# on Netlify, else files in .data/ locally). Set to "blobs" to force Netlify Blobs.
STORAGE=

# Local development only: pretend today is this date (YYYY-MM-DD).
APP_TODAY=
